<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <!-- Создание таблицы history_record (пропустим, если уже есть) -->
    <changeSet id="create-history-record-table" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not><tableExists tableName="history_record"/></not>
        </preConditions>

        <createTable tableName="history_record">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="history_record_pkey"/>
            </column>

            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <!-- ENUM как строка -->
            <column name="status_before" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status_after" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="contract_before_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="contract_after_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Индексы для быстрого поиска -->
    <changeSet id="idx-history-record-user" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="history_record"/>
            <not><indexExists tableName="history_record" indexName="idx_history_record_user"/></not>
        </preConditions>
        <createIndex tableName="history_record" indexName="idx_history_record_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="idx-history-record-contracts" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="history_record"/>
            <not><indexExists tableName="history_record" indexName="idx_history_record_contract_before"/></not>
        </preConditions>
        <createIndex tableName="history_record" indexName="idx_history_record_contract_before">
            <column name="contract_before_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="idx-history-record-contracts-2" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="history_record"/>
            <not><indexExists tableName="history_record" indexName="idx_history_record_contract_after"/></not>
        </preConditions>
        <createIndex tableName="history_record" indexName="idx_history_record_contract_after">
            <column name="contract_after_id"/>
        </createIndex>
    </changeSet>

    <!-- Внешние ключи (добавляем только если всё готово и их ещё нет) -->
    <changeSet id="fk-history-record-user" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="history_record"/>
            <tableExists tableName="users"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_history_record_user"/></not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="history_record"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_history_record_user"
                onDelete="RESTRICT"/>
    </changeSet>

    <changeSet id="fk-history-record-contract-before" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="history_record"/>
            <tableExists tableName="contracts"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_history_record_contract_before"/></not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="history_record"
                baseColumnNames="contract_before_id"
                referencedTableName="contracts"
                referencedColumnNames="id"
                constraintName="fk_history_record_contract_before"
                onDelete="RESTRICT"/>
    </changeSet>

    <changeSet id="fk-history-record-contract-after" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="history_record"/>
            <tableExists tableName="contracts"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_history_record_contract_after"/></not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="history_record"
                baseColumnNames="contract_after_id"
                referencedTableName="contracts"
                referencedColumnNames="id"
                constraintName="fk_history_record_contract_after"
                onDelete="RESTRICT"/>
    </changeSet>

</databaseChangeLog>