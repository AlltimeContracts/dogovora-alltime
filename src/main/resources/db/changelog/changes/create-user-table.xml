<!-- src/main/resources/db/changelog/changes/create-user-table.xml -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="create-users-table" author="alexander.shekunov">
        <!-- Если таблица уже есть в public — помечаем changeSet как выполненный -->
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users" schemaName="public"/>
            </not>
        </preConditions>

        <createTable tableName="users" schemaName="public">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="second_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="third_name" type="VARCHAR(255)"/>
            <column name="login" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="position" type="VARCHAR(255)"/>
            <column name="roles" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>

        <!-- НЕ делаем UNIQUE(id): PK и так уникален -->
    </changeSet>
</databaseChangeLog>