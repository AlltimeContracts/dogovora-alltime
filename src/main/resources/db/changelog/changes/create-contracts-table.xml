<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <!-- Создание таблицы contracts (пропустим, если уже есть) -->
    <changeSet id="create-contracts-table" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not><tableExists tableName="contracts"/></not>
        </preConditions>

        <createTable tableName="contracts">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="contracts_pkey"/>
            </column>

            <column name="contract_num" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="is_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>

            <column name="contract_date_from" type="DATE"/>
            <column name="contract_date_to"   type="DATE"/>

            <column name="client_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <!-- Массив UUID для менеджеров (PostgreSQL) -->
            <column name="manager_id_list" type="UUID[]">
                <constraints nullable="false"/>
            </column>

            <column name="description_text" type="TEXT"/>

            <!-- ENUM как строка -->
            <column name="current_status" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

    <!-- Индексы/ссылки добавляем, только если ещё нет -->
    <changeSet id="idx-contracts-client" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="contracts"/>
            <not><indexExists tableName="contracts" indexName="idx_contracts_client"/></not>
        </preConditions>
        <createIndex tableName="contracts" indexName="idx_contracts_client">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="fk-contracts-client" author="Alexander">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="contracts"/>
            <tableExists tableName="client"/>
            <not><foreignKeyConstraintExists foreignKeyName="fk_contracts_client"/></not>
        </preConditions>
        <addForeignKeyConstraint
                baseTableName="contracts"
                baseColumnNames="client_id"
                referencedTableName="client"
                referencedColumnNames="id"
                constraintName="fk_contracts_client"
                onDelete="RESTRICT"/>
    </changeSet>

</databaseChangeLog>